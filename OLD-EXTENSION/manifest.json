{
  "manifest_version": 3,
  "name": "Pair Browsing",
  "version": "1.0",
  "description": "AI-powered pair browsing assistant",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "debugger",
    "sidePanel",
    "unlimitedStorage",
    "windows"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://zystudio.zybooks.com/*"
  ],
  "action": {
    "default_title": "Pair Browsing",
    "default_popup": "options.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  }
}